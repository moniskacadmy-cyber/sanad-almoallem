{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "System administrator with management privileges.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "createdAt"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher account with profile and subscription details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "maxLength": 256 },
        "whatsapp": { "type": "string", "minLength": 8, "maxLength": 30 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 100 },
        "role": { "type": "string", "enum": ["teacher", "admin"] },
        "subscriptionStatus": { "type": "string", "enum": ["trial", "active", "expired"] },
        "plan": { "type": "string", "enum": ["none", "monthly", "six_months", "yearly", "three_months", "custom"] },
        "isActive": { "type": "boolean" },
        "subscriptionEndDate": { "type": "string", "format": "date-time" },
        "trialStartDate": { "type": "string", "format": "date-time" },
        "trialEndDate": { "type": "string", "format": "date-time" },
        "subscriptionExpiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "whatsapp", "subject", "role", "subscriptionStatus", "plan", "trialStartDate", "trialEndDate", "subscriptionExpiresAt", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student enrolled with a teacher.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 100 },
        "classType": { "type": "string", "enum": ["online", "center", "private"] },
        "monthlyFee": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["paid", "unpaid"] },
        "lastPaymentMonth": { "type": "string", "maxLength": 20 },
        "totalPrepaidLessons": { "type": "number" },
        "remainingPaidLessons": { "type": "number" },
        "learningStyle": { "type": "string", "maxLength": 1000 },
        "notes": { "type": "string", "maxLength": 1000 },
        "color": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teacherId", "name", "subject", "classType", "monthlyFee", "paymentStatus", "createdAt", "updatedAt"]
    },
    "LessonLog": {
      "title": "LessonLog",
      "description": "Log of a class session for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 30 },
        "topic": { "type": "string", "maxLength": 500 },
        "homework": { "type": "string", "maxLength": 500 },
        "attendance": { "type": "string", "enum": ["present", "absent", "excused"] },
        "rating": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "isFinancialCounted": { "type": "boolean" },
        "hasMakeupClass": { "type": "boolean" },
        "makeupClassDate": { "type": "string", "maxLength": 100 },
        "absenceReasonType": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "teacherId", "date", "topic", "attendance", "createdAt"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Class timetable schedule slot.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "dayOfWeek": { "type": "number" },
        "time": { "type": "string", "maxLength": 20 },
        "duration": { "type": "number" },
        "recurrence": { "type": "string", "enum": ["daily", "weekly", "monthly", "once"] },
        "classType": { "type": "string", "enum": ["online", "center", "private"] },
        "color": { "type": "string", "maxLength": 50 },
        "locationOrLink": { "type": "string", "maxLength": 500 },
        "completedTodayDate": { "type": "string", "maxLength": 30 },
        "rating": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teacherId", "studentId", "studentName", "dayOfWeek", "time", "duration", "recurrence", "classType", "createdAt", "updatedAt"]
    },
    "LibraryItem": {
      "title": "LibraryItem",
      "description": "Preparation template, curriculum book, or quiz in teacher library.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "type": { "type": "string", "enum": ["lesson_plan", "quiz", "summary", "pdf", "image", "book"] },
        "subject": { "type": "string", "maxLength": 100 },
        "content": { "type": "string", "maxLength": 50000 },
        "fileName": { "type": "string", "maxLength": 200 },
        "fileSize": { "type": "string", "maxLength": 50 },
        "fileData": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teacherId", "title", "type", "content", "createdAt", "updatedAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Pre-activated teacher subscription records by email.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "isActive": { "type": "boolean" },
        "subscriptionEndDate": { "type": "string", "format": "date-time" },
        "plan": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "isActive", "subscriptionEndDate"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Automated reminder log for upcoming classes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "target": { "type": "string", "enum": ["parent", "teacher"] },
        "recipientPhone": { "type": "string", "maxLength": 30 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "classTime": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["sent", "scheduled", "delivered"] },
        "messageText": { "type": "string", "maxLength": 2000 },
        "whatsappUrl": { "type": "string", "maxLength": 1000 },
        "minutesBefore": { "type": "number" },
        "sentAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teacherId", "studentName", "target", "classTime", "status", "messageText", "sentAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Quick to-do list items.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 500 },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teacherId", "title", "completed", "createdAt"]
    },
    "QuickNote": {
      "title": "QuickNote",
      "description": "Quick scratchpad note or reminder for teacher.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "color": { "type": "string", "enum": ["amber", "emerald", "purple", "blue", "rose"] },
        "isPinned": { "type": "boolean" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teacherId", "text", "createdAt"]
    },
    "FCMToken": {
      "title": "FCMToken",
      "description": "Firebase Cloud Messaging Web Push token for device notifications.",
      "type": "object",
      "properties": {
        "token": { "type": "string", "maxLength": 500 },
        "userAgent": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "createdAt", "updatedAt"]
    },
    "SentReminder": {
      "title": "SentReminder",
      "description": "Deduplication log for sent FCM reminders per class and day.",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "day": { "type": "string", "maxLength": 30 },
        "sentAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scheduleId", "teacherId", "day", "sentAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Stores administrator accounts."
    },
    "/subscriptions/{subId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Stores teacher subscriptions by email."
    },
    "/users/{userId}/fcmTokens/{tokenId}": {
      "schema": { "$ref": "#/entities/FCMToken" },
      "description": "Stores FCM tokens under user profile."
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Stores teacher user profile and subscription status."
    },
    "/teachers/{teacherId}/fcmTokens/{tokenId}": {
      "schema": { "$ref": "#/entities/FCMToken" },
      "description": "Stores FCM device tokens for Web Push notifications."
    },
    "/teachers/{teacherId}/sentReminders/{reminderId}": {
      "schema": { "$ref": "#/entities/SentReminder" },
      "description": "Deduplication log to prevent duplicate notifications."
    },
    "/teachers/{teacherId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Stores students belonging to a teacher."
    },
    "/teachers/{teacherId}/students/{studentId}/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/LessonLog" },
      "description": "Stores session records and attendance for a student."
    },
    "/teachers/{teacherId}/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/Schedule" },
      "description": "Stores weekly class schedule slots."
    },
    "/teachers/{teacherId}/library/{itemId}": {
      "schema": { "$ref": "#/entities/LibraryItem" },
      "description": "Stores preparation plans and quiz templates."
    },
    "/teachers/{teacherId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "Stores automated class reminder logs."
    },
    "/teachers/{teacherId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Stores quick to-do list items for a teacher."
    },
    "/teachers/{teacherId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/QuickNote" },
      "description": "Stores quick notes and scratchpad ideas for a teacher."
    }
  }
}
