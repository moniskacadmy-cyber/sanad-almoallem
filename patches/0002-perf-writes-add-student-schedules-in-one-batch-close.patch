+/**
+ * Creates a student together with its schedule slots in ONE atomic write batch.
+ * The local cache is updated immediately (persistentLocalCache), so snapshot listeners fire right
+ * away; the returned `commitPromise` resolves only when the server acknowledges the write.
+ * The caller should NOT block the UI on `commitPromise`; attach a `.catch` to surface rejections
+ * (Firestore rolls the local write back automatically if the server rejects it).
+ */
+export function addStudentWithSchedules(
+  teacherId: string,
+  student: NewStudentInput,
+  schedules: NewScheduleForStudent[]
+): { studentId: string; scheduleIds: string[]; commitPromise: Promise<void> } {
+  const path = `teachers/${teacherId}/students`;
+  try {
+    const batch = writeBatch(db);
+    const studentsCol = collection(db, 'teachers', teacherId, 'students');
+    const schedulesCol = collection(db, 'teachers', teacherId, 'schedules');
+    const refs = {
+      student: doc(studentsCol),
+      schedules: schedules.map(() => doc(schedulesCol)),
+    };
+    const { studentId, scheduleIds } = stageStudentWithSchedules(
+      batch,
+      refs,
+      teacherId,
+      student,
+      schedules,
+      serverTimestamp()
+    );
+    const commitPromise = batch
+      .commit()
+      .catch((error) => {
+        handleFirestoreError(error, OperationType.CREATE, path);
+        throw error;
+      });
+    return { studentId, scheduleIds, commitPromise };
+  } catch (error) {
+    handleFirestoreError(error, OperationType.CREATE, path);
+    throw error;
+  }
+}
+
+/**
+ * Adds several schedule slots in ONE atomic write batch (same non-blocking contract as
+ * addStudentWithSchedules).
+ */
+export function addSchedulesBatch(
+  teacherId: string,
+  schedules: NewScheduleInput[]
+): { scheduleIds: string[]; commitPromise: Promise<void> } {
+  const path = `teachers/${teacherId}/schedules`;
+  try {
+    const batch = writeBatch(db);
+    const schedulesCol = collection(db, 'teachers', teacherId, 'schedules');
+    const refs = schedules.map(() => doc(schedulesCol));
+    const scheduleIds = stageSchedules(batch, refs, teacherId, schedules, serverTimestamp());
+    const commitPromise = batch
+      .commit()
+      .catch((error) => {
+        handleFirestoreError(error, OperationType.CREATE, path);
+        throw error;
+      });
+    return { scheduleIds, commitPromise };
+  } catch (error) {
+    handleFirestoreError(error, OperationType.CREATE, path);
+    throw error;
+  }
+}
