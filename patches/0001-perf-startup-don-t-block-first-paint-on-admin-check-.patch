@@ -79,6 +79,8 @@ export default function App() {
   const [currentUser, setCurrentUser] = useState<User | null>(null);
   const [profile, setProfile] = useState<TeacherProfile | null>(null);
   const [isAdmin, setIsAdmin] = useState(false);
+  // False until the (background) admin check finishes; true immediately when signed out.
+  const [adminChecked, setAdminChecked] = useState(false);
   const [loadingAuth, setLoadingAuth] = useState(true);
   const [profileLoadingTimeout, setProfileLoadingTimeout] = useState(false);
   const [profileLoadError, setProfileLoadError] = useState<string | null>(null);
@@ -238,31 +240,40 @@ export default function App() {
 
   // Listen to Auth State
   useEffect(() => {
-    const unsub = onAuthStateChanged(auth, async (user) => {
-      try {
-        setCurrentUser(user);
-        if (user) {
-          try {
-            const adminStatus = await checkIsAdmin(user);
+    let isMounted = true;
+    const unsub = onAuthStateChanged(auth, (user) => {
+      // Never block the first paint on extra network round trips.
+      setCurrentUser(user);
+      setLoadingAuth(false);
+
+      if (user) {
+        setAdminChecked(false);
+        // Admin check runs in the background; the UI updates when it resolves.
+        checkIsAdmin(user)
+          .then((adminStatus) => {
+            if (!isMounted) return;
             setIsAdmin(adminStatus);
-          } catch (e) {
+            setAdminChecked(true);
+          })
+          .catch((e) => {
             console.warn('checkIsAdmin error:', e);
+            if (!isMounted) return;
             setIsAdmin(false);
-          }
-          requestAndSaveFCMToken().then((result) => {
-            if (!result.success) console.warn('FCM notification registration:', result.error);
-          }).catch((e) => console.warn('FCM token error:', e));
-        } else {
-          setProfile(null);
-          setIsAdmin(false);
-        }
-      } catch (err) {
-        console.error('Error in onAuthStateChanged listener:', err);
-      } finally {
-        setLoadingAuth(false);
+            setAdminChecked(true);
+          });
+        requestAndSaveFCMToken().then((result) => {
+          if (!result.success) console.warn('FCM notification registration:', result.error);
+        }).catch((e) => console.warn('FCM token error:', e));
+      } else {
+        setProfile(null);
+        setIsAdmin(false);
+        setAdminChecked(true);
       }
     });
-    return () => unsub();
+    return () => {
+      isMounted = false;
+      unsub();
+    };
   }, []);
 
   // Listen to Teacher Profile (with auto-provision fallback)
@@ -322,7 +333,9 @@ export default function App() {
 
   // Listen to Students, Schedules, and Library
   useEffect(() => {
-    if (!currentUser || !profile) {
+    // Teacher document id === auth uid (see firestore.rules isTeacherOwner), and read access to
+    // these subcollections only depends on the uid, so we do not need to wait for `profile`.
+    if (!currentUser) {
       setStudents([]);
       setSchedules([]);
       setLibraryItems([]);
@@ -338,7 +351,7 @@ export default function App() {
       unsubSchedules();
       unsubLibrary();
     };
-  }, [currentUser, profile?.id]);
+  }, [currentUser?.uid]);
 
   // Run database automatic cleanup script for orphaned schedules and lessons (IIFE triggered)
   useEffect(() => {
@@ -438,6 +451,7 @@ export default function App() {
           <AdminSecretGate
             currentUser={currentUser}
             isAdmin={isAdmin}
+            adminChecked={adminChecked}
             onBackToApp={() => navigateTo('/')}
           />
         </div>
