rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTeacherOwner(teacherId) {
      return isSignedIn() && request.auth.uid == teacherId;
    }

    // Enforce active subscription or admin status for write operations
    function isTeacherSubscriptionActive(teacherId) {
      return isAdmin() || (
        get(/databases/$(database)/documents/teachers/$(teacherId)).data.isActive != false &&
        get(/databases/$(database)/documents/teachers/$(teacherId)).data.subscriptionExpiresAt > request.time
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() < 100;
    }

    // Validation for new teacher profile registration
    function isValidNewTeacher(teacherId) {
      let data = incoming();
      let email = request.auth.token.email;
      let normalizedEmail = request.auth.token.email != null ? request.auth.token.email.lower() : '';
      let hasExactSubscription = email != null &&
        exists(/databases/$(database)/documents/subscriptions/$(email));
      let hasNormalizedSubscription = email != null &&
        exists(/databases/$(database)/documents/subscriptions/$(normalizedEmail));
      let hasPreprovisionedSubscription =
        email != null &&
        request.auth.token.email_verified == true &&
        (hasExactSubscription || hasNormalizedSubscription);

      return isValidId(teacherId) &&
        data.keys().hasOnly([
          'id', 'name', 'email', 'whatsapp', 'subject', 'role',
          'subscriptionStatus', 'plan', 'isActive', 'subscriptionEndDate',
          'trialStartDate', 'trialEndDate', 'subscriptionExpiresAt'
        ]);
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOwner(teacherId) && isValidNewTeacher(teacherId);
      allow update: if isTeacherOwner(teacherId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // General fallback for subcollections under teachers
    match /teachers/{teacherId}/{document=**} {
      allow read, write: if isTeacherOwner(teacherId) || isAdmin();
    }
  }
}