import { ResponsiveContainer, BarChart, Bar, XAxis, YAxis, Tooltip, CartesianGrid } from 'recharts';

export default function FinancialAnalytics({ data }) {
  const [isAccordionOpen, setIsAccordionOpen] = useState(true);

  // بيانات توضيحية للإيرادات والمصروفات
  const chartData = data || [
    { month: 'يناير', إيرادات: 4000, مصروفات: 2400 },
    { month: 'فبراير', إيرادات: 3000, مصروفات: 1398 },
    { month: 'مارس', إيرادات: 9800, مصروفات: 2000 },
    { month: 'أبريل', إيرادات: 3908, مصروفات: 2780 },
  ];

  return (
    <div className="bg-white p-4 rounded-xl shadow border space-y-4" dir="rtl">
      {/* القسم القابل للطي Accordion Header */}
      <button 
        onClick={() => setIsAccordionOpen(!isAccordionOpen)}
        className="w-full flex justify-between items-center text-lg font-bold py-2 border-b"
      >
        <span>📊 التحليلات والتقرير المالي</span>
        <span>{isAccordionOpen ? '▲' : '▼'}</span>
      </button>

