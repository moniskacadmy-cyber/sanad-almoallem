JavaScript
import React, { useState } from 'react';
import { collection, addDoc, doc, updateDoc, arrayUnion } from 'firebase/firestore';
import { db } from '../firebase';

export default function GroupsManager({ groups, students }) {
  const [groupName, setGroupName] = useState('');
  const [schedule, setSchedule] = useState('');
  const [searchQuery, setSearchQuery] = useState('');
  const [error, setError] = useState('');

  // 1. إضافة مجموعة جديدة مع التحقق (Validation)
  const handleAddGroup = async (e) => {
    e.preventDefault();
    if (!groupName.trim() || !schedule.trim()) {
      setError('يرجى ملء جميع الحقول المطلوبة');
      return;
    }
    try {
      await addDoc(collection(db, 'groups'), {
        name: groupName,
        schedule: schedule,
        createdAt: new Date()
      });
      setGroupName('');
      setSchedule('');
      setError('');
      alert('تمت إضافة المجموعة بنجاح');
    } catch (err) {
      console.error("خطأ أثناء إضافة المجموعة:", err);
      setError('حدث خطأ أثناء حفظ البيانات');
    }
  };

  // 2. إرسال تذكير واتساب للطلاب
  const sendWhatsAppReminder = (phone, studentName, groupName) => {
    const message = `أهلاً ${studentName}، نود تذكيرك بموعد الحصة القادمة لمجموعة (${groupName}).`;
    const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
    window.open(url, '_blank');
  };

  // 3. تسجيل الحضور في Firestore
  const handleAttendance = async (studentId, status) => {
    try {
      const studentRef = doc(db, 'students', studentId);
      await updateDoc(studentRef, {
        attendanceHistory: arrayUnion({
          date: new Date().toISOString().split('T')[0],
          status: status
        })
      });
      alert('تم تسجيل الحضور بنجاح');
    } catch (err) {
      console.error("خطأ في تسجيل الحضور:", err);
    }
  };

  // 4. الفلترة والبحث المتقدم
  const filteredStudents = students.filter(s => 
    s.name.includes(searchQuery) || (s.phone && s.phone.includes(searchQuery))
  );

  return (
    <div className="p-4 space-y-6" dir="rtl">
      {/* نموذج إدخال مجموعة جديدة */}
      <form onSubmit={handleAddGroup} className="bg-white p-4 rounded-xl shadow border space-y-3">
        <h3 className="font-bold text-lg">إضافة مجموعة جديدة</h3>
        {error && <p className="text-red-500 text-sm">{error}</p>}
        <input 
          type="text" 
          placeholder="اسم المجموعة" 
          value={groupName} 
          onChange={(e) => setGroupName(e.target.value)}
          className="w-full border p-2 rounded-lg"
        />
        <input 
          type="text" 
          placeholder="المواعيد (مثال: السبت والأربعاء 4 مساءً)" 
          value={schedule} 
          onChange={(e) => setSchedule(e.target.value)}
          className="w-full border p-2 rounded-lg"
        />
        <button type="submit" className="bg-blue-600 text-white px-4 py-2 rounded-lg w-full font-bold">
          حفظ المجموعة
        </button>
      </form>

      {/* البحث والفلترة */}
      <div className="bg-white p-4 rounded-xl shadow border">
        <input 
          type="text" 
          placeholder="ابحث باسم الطالب أو رقم الهاتف..." 
          value={searchQuery}
          onChange={(e) => setSearchQuery(e.target.value)}
          className="w-full border p-2 rounded-lg mb-4"
        />

        <h4 className="font-bold mb-2">قائمة الطلاب والتأكيد عبر واتساب:</h4>
        <div className="space-y-2">
          {filteredStudents.map((student) => (
            <div key={student.id} className="flex items-center justify-between border-b pb-2">
              <div>
                <p className="font-semibold">{student.name}</p>
                <p className="text-xs text-gray-500">{student.groupName || 'بدون مجموعة'}</p>
              </div>
              <div className="flex gap-2">
                <button 
                  onClick={() => handleAttendance(student.id, 'حضور')}
                  className="bg-green-100 text-green-700 px-2 py-1 rounded text-xs"
                >
                  حاضر
                </button>
                <button 
                  onClick={() => handleAttendance(student.id, 'غياب')}
                  className="bg-red-100 text-red-700 px-2 py-1 rounded text-xs"
                >
                  غائب
                </button>
                {student.phone && (
                  <button 
                    onClick={() => sendWhatsAppReminder(student.phone, student.name, student.groupName)}
                    className="bg-emerald-600 text-white px-2 py-1 rounded text-xs"
                  >
                    واتساب
                  </button>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}
