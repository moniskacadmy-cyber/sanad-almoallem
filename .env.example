# ==========================================
# بيئة عمل منصة سند المعلم - Sanad Al-Moallem
# ==========================================

# 1. مفتاح الذكاء الاصطناعي (Google Gemini AI) - يُستخدم في خوادم Vercel Serverless
GEMINI_API_KEY=

# 2. بيانات حساب خدمة Firebase Admin (للتحقق من التوكنات وصلاحيات الـ API)
# يمكنك استخدام JSON كامل:
FIREBASE_SERVICE_ACCOUNT=

# أو الحقول المنفصلة كبديل:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3. إعدادات Firebase من جانب العميل (Client-side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
