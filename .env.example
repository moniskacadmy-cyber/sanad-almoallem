# ==========================================
# بيئة عمل منصة سند المعلم - Sanad Al-Moallem
# ==========================================

# 1. مفتاح ونموذج الذكاء الاصطناعي (Google Gemini AI) - يُستخدم في خوادم Vercel Serverless
GEMINI_API_KEY=
# نموذج Gemini المستخدم في المساعد الذكي (الافتراضي: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. بيانات حساب خدمة Firebase Admin (للتحقق من التوكنات وصلاحيات الـ API)
# يمكنك استخدام JSON كامل:
FIREBASE_SERVICE_ACCOUNT=

# أو الحقول المنفصلة كبديل:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3. إعدادات Firebase من جانب العميل (Client-side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# مفتاح VAPID المولد من Firebase Console -> Project Settings -> Cloud Messaging -> Web Configuration
VITE_FIREBASE_VAPID_KEY=
# اتركه فارغًا لاستخدام إعدادات AI Studio، أو ضع (default) إذا كنت تستخدم قاعدة بيانات Firestore الافتراضية في مشروع Firebase الخاص بك
VITE_FIREBASE_DATABASE_ID=

# 4. رمز السرية لخدمة التذكيرات التلقائية (Cron Job Secret)
# يُستخدم لتأمين مسار GET /api/reminders/cron
CRON_SECRET=CHANGE_ME_IN_VERCEL

# 5. WhatsApp Cloud API - automatic teacher reminders while the app is closed
# Requires a Meta WhatsApp Business number and an approved reminder template.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=ar
WHATSAPP_SEND_TO_TEACHER=true



# 6. AI abuse/cost protection (server-side Redis required on Vercel)
# Total AI requests allowed per verified user per rolling 24-hour window.
AI_DAILY_REQUESTS=100
# Upstash Redis REST credentials used for distributed rate limiting and quotas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
