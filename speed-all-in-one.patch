+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  thinkingConfigForModel,
+  applyModelThinking,
+  isFallbackEligibleError,
+  resolveFallbackModel,
+  ASSISTANT_ALLOWED_MODELS,
+} from '../src/server/geminiConfig';
+
+test('thinkingConfigForModel: MINIMAL for 3.1-flash-lite / 3.5-flash / 3.6-flash', () => {
+  for (const m of ['gemini-3.1-flash-lite', 'gemini-3.5-flash', 'gemini-3.6-flash']) {
+    assert.deepEqual(thinkingConfigForModel(m), { thinkingLevel: 'MINIMAL' }, m);
+  }
+});
+
+test('thinkingConfigForModel: LOW (never MINIMAL) for 3.7 / 3.8 flash', () => {
+  for (const m of ['gemini-3.8-flash', 'gemini-3.7-flash']) {
+    assert.deepEqual(thinkingConfigForModel(m), { thinkingLevel: 'LOW' }, m);
+  }
+});
+
+test('thinkingConfigForModel: nothing for other / unknown / empty models', () => {
+  for (const m of ['gemini-2.5-flash', 'gemma-4-26b-a4b-it', 'gemini-3.5-flash-lite', 'whatever', '', undefined, null]) {
+    assert.equal(thinkingConfigForModel(m as any), undefined, String(m));
+  }
+});
+
+test('every allowed assistant model has a thinking config (so none runs at the slow default)', () => {
+  for (const m of ASSISTANT_ALLOWED_MODELS) assert.ok(thinkingConfigForModel(m), m);
+  assert.ok(!(ASSISTANT_ALLOWED_MODELS as readonly string[]).includes('gemini-4-argon'));
+});
+
+test('applyModelThinking sets the level for the request model and keeps other config', () => {
+  const out = applyModelThinking({
+    model: 'gemini-3.8-flash',
+    contents: 'x',
+    config: { systemInstruction: 'sys', maxOutputTokens: 1024 },
+  } as any);
+  assert.deepEqual((out as any).config, {
+    systemInstruction: 'sys',
+    maxOutputTokens: 1024,
+    thinkingConfig: { thinkingLevel: 'LOW' },
+  });
+  assert.equal((out as any).contents, 'x');
+});
+
+test('applyModelThinking drops a stale thinkingConfig when the model has no mapping (fallback safety)', () => {
+  const out = applyModelThinking({
+    model: 'gemma-4-26b-a4b-it',
+    config: { systemInstruction: 'sys', thinkingConfig: { thinkingLevel: 'MINIMAL' } },
+  } as any);
+  assert.deepEqual((out as any).config, { systemInstruction: 'sys' });
+});
+
+test('applyModelThinking works when no config was supplied and does not mutate its input', () => {
+  const input: any = { model: 'gemini-3.1-flash-lite', contents: 'x' };
+  const out: any = applyModelThinking(input);
+  assert.deepEqual(out.config, { thinkingConfig: { thinkingLevel: 'MINIMAL' } });
+  assert.equal(input.config, undefined);
+});
+
+test('isFallbackEligibleError: 404 / NOT_FOUND / model not found / quota / 5xx -> fallback', () => {
+  assert.equal(isFallbackEligibleError({ status: 404 }), true);
+  assert.equal(isFallbackEligibleError({ code: 404 }), true);
+  assert.equal(isFallbackEligibleError({ message: 'models/foo is not found for API version v1beta' }), true);
+  assert.equal(isFallbackEligibleError({ message: '{"error":{"status":"NOT_FOUND"}}' }), true);
+  for (const status of [429, 500, 502, 503, 504]) assert.equal(isFallbackEligibleError({ status }), true, String(status));
+  assert.equal(isFallbackEligibleError({ message: 'The model is overloaded. high demand' }), true);
+});
+
+test('isFallbackEligibleError: 400 / 401 / 403 / plain errors -> NO fallback', () => {
+  for (const status of [400, 401, 403]) assert.equal(isFallbackEligibleError({ status }), false, String(status));
+  assert.equal(isFallbackEligibleError(new Error('invalid argument')), false);
+  assert.equal(isFallbackEligibleError(undefined), false);
+});
+
+test('resolveFallbackModel: env override, otherwise gemini-3.5-flash-lite (not Gemma)', () => {
+  assert.equal(resolveFallbackModel({}), 'gemini-3.5-flash-lite');
+  assert.equal(resolveFallbackModel({ GEMINI_FREE_FALLBACK_MODEL: '  ' }), 'gemini-3.5-flash-lite');
+  assert.equal(resolveFallbackModel({ GEMINI_FREE_FALLBACK_MODEL: 'my-model' }), 'my-model');
+});
diff --git a/tests/studentSchedulesBatch.test.ts b/tests/studentSchedulesBatch.test.ts
new file mode 100644
index 0000000..6dea3e7
--- /dev/null
+++ b/tests/studentSchedulesBatch.test.ts
@@ -0,0 +1,112 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  stageSchedules,
+  stageStudentWithSchedules,
+  type NewStudentInput,
+  type NewScheduleForStudent,
+} from '../src/services/studentSchedulesBatch';
+
+type Ref = { id: string };
+
+function makeFakeBatch() {
+  const sets: Array<{ ref: Ref; data: Record<string, unknown> }> = [];
+  let commits = 0;
+  return {
+    sets,
+    get commits() {
+      return commits;
+    },
+    set(ref: Ref, data: Record<string, unknown>) {
+      sets.push({ ref, data });
+    },
+    commit() {
+      commits++;
+      return Promise.resolve();
+    },
+  };
+}
+
+const TS = { __ts: 'serverTimestamp' };
+
+const student = {
+  name: 'أحمد',
+  whatsapp: '0100',
+  subject: 'رياضيات',
+  classType: 'online',
+  hourlyRate: 100,
+  monthlyFee: 400,
+  paymentStatus: 'unpaid',
+  color: 'emerald',
+  notes: '',
+} as unknown as NewStudentInput;
+
+const slots: NewScheduleForStudent[] = [
+  { dayOfWeek: 0, time: '16:00', duration: 60, recurrence: 'weekly', classType: 'online', color: 'emerald' },
+  { dayOfWeek: 2, time: '17:30', duration: 90, recurrence: 'weekly', classType: 'online', color: 'emerald' },
+  { dayOfWeek: 4, time: '18:00', duration: 60, recurrence: 'weekly', classType: 'online', color: 'emerald' },
+];
+
+test('stageStudentWithSchedules stages exactly 1 student + N schedules and never commits', () => {
+  const batch = makeFakeBatch();
+  const refs = { student: { id: 'stu1' }, schedules: [{ id: 's1' }, { id: 's2' }, { id: 's3' }] };
+
+  const out = stageStudentWithSchedules(batch, refs, 'teacherA', student, slots, TS);
+
+  assert.equal(batch.sets.length, 4, 'one student + three schedules');
+  assert.equal(batch.commits, 0, 'staging must not commit (the caller commits without awaiting)');
+  assert.equal(out.studentId, 'stu1');
+  assert.deepEqual(out.scheduleIds, ['s1', 's2', 's3']);
+
+  const [studentWrite, ...scheduleWrites] = batch.sets;
+  assert.equal(studentWrite.ref.id, 'stu1');
+  assert.equal(studentWrite.data.id, 'stu1');
+  assert.equal(studentWrite.data.teacherId, 'teacherA');
+  assert.equal(studentWrite.data.name, 'أحمد');
+  assert.equal(studentWrite.data.createdAt, TS);
+  assert.equal(studentWrite.data.updatedAt, TS);
+
+  scheduleWrites.forEach((w, i) => {
+    assert.equal(w.data.id, refs.schedules[i].id);
+    assert.equal(w.data.teacherId, 'teacherA');
+    assert.equal(w.data.studentId, 'stu1', 'schedule is linked to the new student');
+    assert.equal(w.data.studentName, 'أحمد');
+    assert.equal(w.data.dayOfWeek, slots[i].dayOfWeek);
+    assert.equal(w.data.time, slots[i].time);
+    assert.equal(w.data.duration, slots[i].duration);
+    assert.equal(w.data.recurrence, 'weekly');
+    assert.equal(w.data.createdAt, TS);
+    assert.equal(w.data.updatedAt, TS);
+  });
+});
+
+test('stageStudentWithSchedules works with zero schedules', () => {
+  const batch = makeFakeBatch();
+  const out = stageStudentWithSchedules(batch, { student: { id: 'x' }, schedules: [] }, 't', student, [], TS);
+  assert.equal(batch.sets.length, 1);
+  assert.deepEqual(out.scheduleIds, []);
+});
+
+test('stageSchedules stages one write per slot and keeps the supplied studentId', () => {
+  const batch = makeFakeBatch();
+  const ids = stageSchedules(
+    batch,
+    [{ id: 'a' }, { id: 'b' }],
+    'teacherB',
+    [
+      { studentId: 'stuX', studentName: 'سارة', ...slots[0] },
+      { studentId: 'stuX', studentName: 'سارة', ...slots[1] },
+    ],
+    TS
+  );
+  assert.deepEqual(ids, ['a', 'b']);
+  assert.equal(batch.sets.length, 2);
+  assert.equal(batch.commits, 0);
+  assert.ok(batch.sets.every((w) => w.data.studentId === 'stuX' && w.data.teacherId === 'teacherB'));
+});
+
+test('stageSchedules rejects mismatched refs/schedules', () => {
+  const batch = makeFakeBatch();
+  assert.throws(() => stageSchedules(batch, [{ id: 'a' }], 't', [], TS), /mismatch/);
+  assert.equal(batch.sets.length, 0);
+});
diff --git a/tests/subscriptionAccess.test.ts b/tests/subscriptionAccess.test.ts
index 8a12dc1..89ed713 100644
--- a/tests/subscriptionAccess.test.ts
+++ b/tests/subscriptionAccess.test.ts
@@ -5,6 +5,7 @@ import {
   createSubscriptionGuard,
   evaluateSubscription,
   parseExpiryDateServer,
+  withAccessCache,
   type AccessDeps,
   type TeacherSubscriptionData,
 } from '../src/server/subscriptionAccess.ts';
@@ -220,3 +221,119 @@ test('middleware: ignores any teacherId/uid the client could send (uid comes onl
   await guard(req as never, { status: () => ({ json: () => undefined }) }, () => {});
   assert.deepEqual(seen, ['real-uid']);
 });
+
+/* ---------- withAccessCache (30s TTL cache) ---------- */
+
+function cacheHarness(teacher: TeacherSubscriptionData | null, admin = false) {
+  let t = 0;
+  const calls = { teacher: 0, admin: 0 };
+  let currentTeacher = teacher;
+  let currentAdmin = admin;
+  let nowDate = NOW;
+  const base: AccessDeps = {
+    now: () => nowDate,
+    isAdmin: async () => {
+      calls.admin++;
+      return currentAdmin;
+    },
+    readTeacher: async () => {
+      calls.teacher++;
+      return currentTeacher;
+    },
+    logError: () => {},
+  };
+  const cached = withAccessCache(base, { ttlMs: 30_000, maxEntries: 3, nowMs: () => t });
+  return {
+    cached,
+    calls,
+    advance: (ms: number) => {
+      t += ms;
+      nowDate = new Date(nowDate.getTime() + ms);
+    },
+    setTeacher: (x: TeacherSubscriptionData | null) => {
+      currentTeacher = x;
+    },
+    setAdmin: (x: boolean) => {
+      currentAdmin = x;
+    },
+  };
+}
+
+test('cache: active teacher + admin result are served from memory within 30s, refreshed after', async () => {
+  const h = cacheHarness({ subscriptionExpiresAt: ts(FUTURE) });
+  await h.cached.readTeacher('u1');
+  await h.cached.isAdmin('u1');
+  h.advance(29_000);
+  await h.cached.readTeacher('u1');
+  await h.cached.isAdmin('u1');
+  assert.deepEqual(h.calls, { teacher: 1, admin: 1 }, 'second round served from cache');
+  h.advance(2_000); // 31s since the first read
+  await h.cached.readTeacher('u1');
+  await h.cached.isAdmin('u1');
+  assert.deepEqual(h.calls, { teacher: 2, admin: 2 }, 'refetched after TTL expiry');
+});
+
+test('cache: a deactivation is visible after at most 30 seconds', async () => {
+  const h = cacheHarness({ subscriptionExpiresAt: ts(FUTURE) });
+  const guard = (d: AccessDeps) => authorizeActiveSubscription('u1', d);
+  assert.equal((await guard(h.cached)).ok, true);
+  h.setTeacher({ subscriptionExpiresAt: ts(FUTURE), isActive: false });
+  h.advance(31_000);
+  const after = await guard(h.cached);
+  assert.equal(after.ok, false);
+  if (!after.ok) assert.equal(after.code, 'account_deactivated');
+});
+
+test('cache: expiry is honoured exactly even while the teacher document is cached', async () => {
+  const soon = new Date(NOW.getTime() + 10_000);
+  const h = cacheHarness({ subscriptionExpiresAt: ts(soon) });
+  assert.equal((await authorizeActiveSubscription('u1', h.cached)).ok, true);
+  h.advance(11_000); // subscription ended 1s ago, but cache TTL (30s) has not elapsed
+  const r = await authorizeActiveSubscription('u1', h.cached);
+  assert.equal(r.ok, false);
+  if (!r.ok) assert.equal(r.code, 'subscription_expired');
+  assert.equal(h.calls.teacher, 1, 'decision came from cached data, re-evaluated against the clock');
+});
+
+test('cache: expired / deactivated / missing teachers are NOT cached (renewals apply immediately)', async () => {
+  const h = cacheHarness({ subscriptionExpiresAt: ts(PAST) });
+  assert.equal((await authorizeActiveSubscription('u1', h.cached)).ok, false);
+  h.setTeacher({ subscriptionExpiresAt: ts(FUTURE) }); // admin renews
+  assert.equal((await authorizeActiveSubscription('u1', h.cached)).ok, true, 'renewal visible immediately');
+
+  const missing = cacheHarness(null);
+  assert.equal((await authorizeActiveSubscription('u2', missing.cached)).ok, false);
+  missing.setTeacher({ subscriptionExpiresAt: ts(FUTURE) }); // profile just created
+  assert.equal((await authorizeActiveSubscription('u2', missing.cached)).ok, true);
+});
+
+test('cache: errors are never cached and still fail closed with 503', async () => {
+  let fail = true;
+  const base: AccessDeps = {
+    now: () => NOW,
+    isAdmin: async () => false,
+    readTeacher: async () => {
+      if (fail) throw new Error('down');
+      return { subscriptionExpiresAt: ts(FUTURE) };
+    },
+    logError: () => {},
+  };
+  const cached = withAccessCache(base, { nowMs: () => 0 });
+  const first = await authorizeActiveSubscription('u1', cached);
+  assert.equal(first.ok, false);
+  if (!first.ok) assert.equal(first.status, 503);
+  fail = false;
+  assert.equal((await authorizeActiveSubscription('u1', cached)).ok, true);
+});
+
+test('cache: never holds more than maxEntries (oldest evicted first)', async () => {
+  const h = cacheHarness({ subscriptionExpiresAt: ts(FUTURE) });
+  for (const uid of ['a', 'b', 'c', 'd']) await h.cached.readTeacher(uid); // maxEntries = 3 -> 'a' evicted
+  assert.equal(h.calls.teacher, 4);
+  await h.cached.readTeacher('d');
+  await h.cached.readTeacher('c');
+  await h.cached.readTeacher('b');
+  assert.equal(h.calls.teacher, 4, 'b, c, d still cached');
+  await h.cached.readTeacher('a');
+  assert.equal(h.calls.teacher, 5, 'a was evicted and refetched');
+});
