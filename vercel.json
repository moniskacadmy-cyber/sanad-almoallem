{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/chat.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/reminders/*.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}
